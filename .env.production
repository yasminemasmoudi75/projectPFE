# ═══════════════════════════════════════════════════════════════════════
# PRODUCTION ENVIRONMENT CONFIGURATION
# Ce fichier est utilisé lors du déploiement en production
# ═══════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════
# Gmail OAuth 2.0 Configuration
# ═══════════════════════════════════════════════════════════════════════

# ⚠️ IMPORTANT: Ces valeurs DOIVENT correspondre à celles enregistrées 
# dans Google Cloud Console pour le CLIENT_ID

GMAIL_CLIENT_ID=111324977592873307756
GMAIL_CLIENT_SECRET=YOUR_ACTUAL_PRODUCTION_SECRET_HERE
# ⚠️ IMPORTANT: Ceci DOIT être exactement comme dans Google Cloud Console
GMAIL_REDIRECT_URI=https://www.nexus-crm.com/api/auth/gmail/callback

# Frontend URL pour les redirects
FRONTEND_URL=https://www.nexus-crm.com

# ═══════════════════════════════════════════════════════════════════════
# Database Configuration (Production)
# ═══════════════════════════════════════════════════════════════════════

# Utiliser un vrai serveur SQL Server en production (pas localhost)
DB_SERVER=prod-sql-server.example.com
DB_USER=production_user
DB_PASSWORD=STRONG_PASSWORD_HERE
DB_DATABASE=AmsLabOrigin_Prod
DB_PORT=1433

# ═══════════════════════════════════════════════════════════════════════
# Application Settings
# ═══════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3066
LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════════
# Security (Production)
# ═══════════════════════════════════════════════════════════════════════

JWT_SECRET=YOUR_SECURE_JWT_SECRET_HERE_CHANGE_ME
JWT_EXPIRE=24h
CORS_ORIGIN=https://www.nexus-crm.com
